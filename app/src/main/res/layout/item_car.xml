<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin"
    android:layout_marginVertical="10dp"
    android:background="@drawable/bg_car_card"
    android:paddingHorizontal="24dp"
    android:paddingTop="40dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tvModel"
        style="@style/Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textFontWeight="600"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvBrand"
        style="@style/Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/ivCar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvModel" />

    <TextView
        android:id="@+id/tvPrice"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textFontWeight="600"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBrand" />

    <TextView
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/per_day"
        android:textColor="@color/text_muted"
        app:layout_constraintBaseline_toBaselineOf="@id/tvPrice"
        app:layout_constraintStart_toEndOf="@id/tvPrice" />

    <TextView
        android:id="@+id/tvTransmission"
        style="@style/CarSpec"
        android:layout_marginTop="16dp"
        android:drawableStart="@drawable/ic_transmission"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPrice" />

    <TextView
        android:id="@+id/tvFuel"
        style="@style/CarSpec"
        android:layout_marginStart="16dp"
        android:drawableStart="@drawable/ic_fuel"
        app:layout_constraintBaseline_toBaselineOf="@id/tvTransmission"
        app:layout_constraintStart_toEndOf="@id/tvTransmission" />

    <ImageView
        android:id="@+id/ivCar"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/car_mercedes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvBrand" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTransmission">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBook"
            style="@style/CarButton"
            android:text="@string/book" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetails"
            style="@style/CarButton.Outlined"
            android:layout_marginStart="16dp"
            android:text="@string/details" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
