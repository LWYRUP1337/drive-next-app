<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <TextView
            style="@style/ScreenTitle"
            android:text="@string/profile" />

        <FrameLayout
            android:id="@+id/avatar"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/add_photo">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:importantForAccessibility="no"
                android:padding="2dp"
                android:src="@drawable/ic_person"
                app:shapeAppearanceOverlay="@style/Shape.Circle"
                app:strokeColor="@color/primary"
                app:strokeWidth="2dp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_add_badge" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvName"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvJoined"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin">

            <TextView
                style="@style/ProfileLabel"
                android:text="@string/email" />

            <TextView
                android:id="@+id/tvEmail"
                style="@style/ProfileValue" />
        </LinearLayout>

        <View
            style="@style/Divider"
            android:layout_marginHorizontal="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin">

            <TextView
                style="@style/ProfileLabel"
                android:text="@string/password" />

            <TextView
                style="@style/ProfileValue"
                android:text="@string/change_password"
                android:textColor="@color/primary" />
        </LinearLayout>

        <View
            style="@style/Divider"
            android:layout_marginHorizontal="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin">

            <TextView
                style="@style/ProfileLabel"
                android:text="@string/gender" />

            <TextView
                android:id="@+id/tvGender"
                style="@style/ProfileValue" />
        </LinearLayout>

        <View
            style="@style/Divider"
            android:layout_marginHorizontal="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin">

            <TextView
                style="@style/ProfileLabel"
                android:text="@string/google" />

            <TextView
                style="@style/ProfileValue"
                android:text="@string/google_not_linked" />
        </LinearLayout>

        <View
            style="@style/Divider"
            android:layout_marginHorizontal="8dp" />

        <TextView
            android:id="@+id/tvSignOut"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingVertical="18dp"
            android:text="@string/sign_out"
            android:textSize="15sp" />
    </LinearLayout>

</ScrollView>
