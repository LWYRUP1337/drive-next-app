<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="72dp"
                android:text="@string/email" />

            <com.google.android.material.textfield.TextInputLayout style="@style/Field">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    style="@style/FieldEdit"
                    android:hint="@string/email_hint"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/FieldLabel"
                android:text="@string/new_password" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Field"
                app:endIconDrawable="@drawable/ic_password_toggle"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    style="@style/FieldEdit"
                    android:hint="@string/password_hint"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/FieldLabel"
                android:text="@string/repeat_password" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Field"
                app:endIconDrawable="@drawable/ic_password_toggle"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRepeatPassword"
                    style="@style/FieldEdit"
                    android:hint="@string/password_hint"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbAgreement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-10dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/montserrat"
                android:paddingStart="6dp"
                android:text="@string/agreement"
                android:textColor="@color/text_label"
                android:textFontWeight="500"
                android:textSize="13sp"
                app:buttonTint="@color/checkbox_tint" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        style="@style/Button"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginBottom="32dp"
        android:text="@string/next"
        android:textSize="14sp" />

</LinearLayout>
